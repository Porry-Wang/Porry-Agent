# PorryAgent 配置模板：将本文件重命名为 .env 即可直接使用。
# 默认 mock，无需密钥即可离线测试。

# 模型选择：「厂商:模型名」或裸名（用默认厂商）；默认 mock 未显式指定时启动告警
PORRY_AGENT_MODEL=mock
# 默认厂商，裸模型名时使用；已知：openai / deepseek / dashscope / openlux
# PORRY_AGENT_VENDOR=openlux

# 运行上限
PORRY_AGENT_MAX_TURNS=50

# 路径
# 文件操作根目录，空则用当前目录
PORRY_AGENT_WORKSPACE_ROOT=

# 日志
PORRY_AGENT_LOG_LEVEL=INFO