# PorryAgent 配置模板：复制为 .env 后修改。默认 mock，无需密钥即可离线测试。

# 模型接入（全局兜底；跨厂商在 MODELS_FILE 里按模型配）
PORRY_AGENT_PROVIDER=mock
PORRY_AGENT_BASE_URL=https://api.openai.com/v1
# openai 必填
PORRY_AGENT_API_KEY=
PORRY_AGENT_MODEL=mock
# 模型表覆盖文件，空则用内置表
PORRY_AGENT_MODELS_FILE=

# 运行上限
PORRY_AGENT_MAX_TURNS=50

# 日志
PORRY_AGENT_LOG_LEVEL=INFO